<?xml version="1.0" encoding="utf-8"?>
<!-- The AI settings hold the user's own API keys: they stay on this device -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_settings.xml" />
    </device-transfer>
</data-extraction-rules>
